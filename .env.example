APP_ENV=development
HTTP_ADDR=localhost:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
LOG_FORMAT=text
